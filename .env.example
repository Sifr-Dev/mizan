# Application
APP_NAME=go-clean-api
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=info

# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL and Redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_db?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h
REDIS_URL=redis://localhost:6379/0

# JWT (required). Generate a unique local value, for example:
#   openssl rand -hex 32
# The refresh lifetime is an absolute family expiry; rotation does not extend it.
JWT_SECRET=
JWT_ISSUER=go-clean-api
JWT_AUDIENCE=go-clean-api-client
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# Explicit cross-origin allowlist. Leave empty for same-origin-only deployments.
# Production origins must use HTTPS. Injected environment variables take
# precedence over this file, and production processes do not load this file.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API rate limit. Authentication routes use a separate counter namespace with
# the same configured limit. Redis failures fail closed by default.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_SCOPE=api
# Comma-separated CIDRs of reverse proxies allowed to supply forwarding headers.
TRUSTED_PROXY_CIDRS=

# Request limits
REQUEST_MAX_BODY_BYTES=1048576

# Refresh cookie. Set AUTH_COOKIE_SECURE=true behind HTTPS in production.
# SameSite=None also requires Secure=true and an allowed browser Origin.
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict

# Administrator provisioning is never performed by the API. To create one,
# export these values only for the explicit `go run ./cmd/admin` command:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-bytes
# ADMIN_NAME=Administrator
